size = 4,
shape = 19
) +
stat_summary(
fun.data = mean_se,
geom = "errorbar",
width = 0.2,
linewidth = 0.6,
color = "black"
) +
stat_summary(
fun = mean,
geom = "crossbar",
width = 0.6,
fatten = 3,
color = "black"
) +
stat_pvalue_manual(
stat.test,
inherit.aes = FALSE,
label = "p.signif",
tip.length = 0.04,
size = 5.5,
bracket.size = 0.6
) +
scale_color_manual(
values = rep_len(
c("#979dac", "#f08080", "#c09bd8", "#507dbc", "#da588c"),
length.out = length(unique(df$Group))
)
) +
scale_y_continuous(
expand = expansion(mult = c(0, 0.1))
)+
labs(
x = NULL,
y = "TP53 expression"
) +
theme_classic(base_size = 14) +
theme(
legend.position = "none",
axis.text = element_text(
size = 14
),
axis.text.x = element_text(
angle = 45,
hjust = 1
),
axis.title = element_text(
size = 14
),
axis.line = element_line(
linewidth = 0.6
)
)
library(ggplot2)
library(ggpubr)
library(dplyr)
library(rstatix)
df <- data.frame(
Group = rep(c("Control", "HSPA9 KO-1", "HSPA9 KO-2", "HSPA9 OE-1", "HSPA9 OE-2"), each = 10),
Value = c(
rnorm(n = 10, mean = 6, sd = 2.5),
rnorm(n = 10, mean = 13, sd = 2.1),
rnorm(n = 10, mean = 11, sd = 2.2),
rnorm(n = 10, mean = 3, sd = 1.8),
rnorm(n = 10, mean = 4, sd = 2.0)
)
)
df <- df %>%
mutate(
Group = factor(Group, levels = c("Control", "HSPA9 KO-1", "HSPA9 KO-2", "HSPA9 OE-1", "HSPA9 OE-2")),
)
stat.test <- df %>%
wilcox_test(
Value ~ Group,
paired = FALSE,
comparisons = list(
c("Control", "HSPA9 KO-1"),
c("Control", "HSPA9 OE-1")
)
) %>%
adjust_pvalue(
p.col = "p",
output.col = "p.adj",
method = "holm"
) %>%
add_significance(
p.col = "p",
output.col = "p.signif",
cutpoints = c(0, 1e-04, 0.001, 0.01, 0.05, 1),
symbols = c("****", "***", "**", "*", "ns")
) %>%
add_significance(
p.col = "p.adj",
output.col = "p.adj.signif",
cutpoints = c(0, 1e-04, 0.001, 0.01, 0.05, 1),
symbols = c("****", "***", "**", "*", "ns")
) %>%
mutate(
p.label = paste0(
"P = ",
formatC(p, format = "e", digits = 2)
)
) %>%
mutate(
p.adj.label = paste0(
"P = ",
formatC(p.adj, format = "e", digits = 2)
)
) %>%
add_y_position(
fun = "max",
step.increase = 0.15
) %>%
ungroup()
ggplot(
df,
aes(
x = Group,
y = Value,
color = Group
)
) +
geom_jitter(
width = 0.16,
size = 4,
shape = 19
) +
stat_summary(
fun.data = mean_se,
geom = "errorbar",
width = 0.2,
linewidth = 0.6,
color = "black"
) +
stat_summary(
fun = mean,
geom = "crossbar",
width = 0.6,
fatten = 3,
color = "black"
) +
stat_pvalue_manual(
stat.test,
inherit.aes = FALSE,
label = "p.signif",
tip.length = 0.04,
size = 5.5,
bracket.size = 0.6
) +
scale_color_manual(
values = rep_len(
c("#979dac", "#f08080", "#c09bd8", "#507dbc", "#da588c"),
length.out = length(unique(df))
)
) +
scale_y_continuous(
expand = expansion(mult = c(0, 0.1))
) +
labs(
x = NULL,
y = "TP53 expression"
) +
theme_classic(base_size = 14) +
theme(
legend.position = "none",
axis.text = element_text(
size = 14
),
axis.text.x = element_text(
angle = 45,
hjust = 1
),
axis.title = element_text(
size = 14
),
axis.line = element_blank(),
panel.border = element_rect(
color = "black",
linewidth = 0.6,
fill = NA
)
)
